+import { invoke } from "@tauri-apps/api/core";
+import { listen, type UnlistenFn } from "@tauri-apps/api/event";
+import { createLogger } from "./logger";
+
+const log = createLogger("Downloads");
+
+export type DownloadStatus =
+  | "queued"
+  | "downloading"
+  | "completed"
+  | "failed"
+  | "cancelled";
+
+export interface DownloadProgress {
+  downloadId: string;
+  videoId: string;
+  title: string;
+  status: DownloadStatus;
+  percent: number;
+  speed: string;
+  eta: string;
+  error?: string;
+  filePath?: string;
+  needsRestart?: boolean;
+}
+
+export interface DownloadRow {
+  youtubeId: string;
+  title: string;
+  status: string;
+  progressPercent: number;
+  errorMessage?: string | null;
+  filePath?: string | null;
+  completedAt?: string | null;
+}
+
+export type DownloadQuality = "1080p" | "720p" | "audio";
+
+export interface DownloadInfo {
+  dir: string;
+  quality: DownloadQuality;
+  /** "none" | browser name | "file:/path/to/cookies.txt" */
+  cookies: string;
+  /** 稳健模式：单连接、分段、节流、403 指数退避 */
+  robust: boolean;
+  /** 检测到 bgutil PO token provider（127.0.0.1:4416） */
+  pot: boolean;
+  /** 全局冷却剩余秒数，>0 表示断路器已触发 */
+  cooldownSeconds: number;
+  libraryFolders: string[];
+}
+
+export const DOWNLOAD_PROGRESS_EVENT = "download:progress";
+
+export const downloadService = {
+  /**
+   * Start a download. Resolves with the download id as soon as yt-dlp is
+   * spawned; progress arrives through `onProgress`.
+   */
+  async start(params: {
+    videoId: string;
+    title: string;
+    artist?: string;
+    quality?: DownloadQuality;
+    /** Prefetch runs silently: no success/failure toast for it. */
+    silent?: boolean;
+    /** "background" = prefetch, yields to user downloads. */
+    priority?: "user" | "background";
+  }): Promise<string> {
+    if (!params.silent) {
+      log.info(`starting download: ${params.videoId} ${params.title}`);
+    }
+    return invoke<string>("youtube_download", {
+      videoId: params.videoId,
+      title: params.title,
+      artist: params.artist ?? null,
+      quality: params.quality ?? null,
+      priority: params.priority ?? "user",
+    });
+  },
+
+  async cancel(downloadId: string): Promise<boolean> {
+    return invoke<boolean>("download_cancel", { downloadId });
+  },
+
+  async list(): Promise<DownloadRow[]> {
+    return invoke<DownloadRow[]>("download_list");
+  },
+
+  /** Resolved destination folder + quality (from settings / library folders). */
+  async info(): Promise<DownloadInfo> {
+    return invoke<DownloadInfo>("download_info");
+  },
+
+  /**
+   * Persist the cookie source used by yt-dlp. YouTube's "Sign in to confirm
+   * you're not a bot" challenge only passes with an authenticated session.
+   */
+  async setCookies(cookies: string): Promise<void> {
+    return invoke("download_set_cookies", { cookies });
+  },
+
+  /** Toggle the conservative download profile. */
+  async setRobust(enabled: boolean): Promise<void> {
+    return invoke("download_set_robust", { enabled });
+  },
+
+  onProgress(callback: (progress: DownloadProgress) => void): Promise<UnlistenFn> {
+    return listen<DownloadProgress>(DOWNLOAD_PROGRESS_EVENT, (event) =>
+      callback(event.payload)
+    );
+  },
+};
