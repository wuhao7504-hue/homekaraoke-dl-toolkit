+//! Keep-awake helper.
+//!
+//! Replaces the `keepawake` crate: on macOS it drives `/usr/bin/caffeinate`,
+//! which is exactly the same mechanism (power assertion) without pulling in a
+//! crate chain that generates IOKit bindings at build time (that build fails on
+//! newer Xcode SDKs because bindgen emits a dangling attribute).
+
+#[cfg(target_os = "macos")]
+pub struct KeepAwake {
+    child: std::process::Child,
+}
+
+#[cfg(target_os = "macos")]
+impl KeepAwake {
+    /// Prevent display and/or idle system sleep while `HomeKaraoke` runs.
+    pub fn create(display: bool, idle: bool) -> Result<Self, String> {
+        let mut command = std::process::Command::new("/usr/bin/caffeinate");
+        if display {
+            command.arg("-d");
+        }
+        if idle {
+            command.arg("-i");
+        }
+        // Tie the assertion to this process: caffeinate exits when we do.
+        command.arg("-w").arg(std::process::id().to_string());
+        let child = command
+            .spawn()
+            .map_err(|e| format!("caffeinate failed to start: {e}"))?;
+        Ok(Self { child })
+    }
+}
+
+#[cfg(target_os = "macos")]
+impl Drop for KeepAwake {
+    fn drop(&mut self) {
+        let _ = self.child.kill();
+        let _ = self.child.wait();
+    }
+}
+
+/// Non-macOS builds keep the API but do nothing.
+#[cfg(not(target_os = "macos"))]
+pub struct KeepAwake;
+
+#[cfg(not(target_os = "macos"))]
+impl KeepAwake {
+    pub fn create(_display: bool, _idle: bool) -> Result<Self, String> {
+        Ok(Self)
+    }
+}
