+//! Download service — saves YouTube videos into the local library folder and
+//! reports progress to the frontend through the `download:progress` event.
+//!
+//! Design notes:
+//! - yt-dlp writes progress with `--newline`; we parse the `[download]  42.3% ...`
+//!   lines and emit them, so the UI does not need its own parser.
+//! - The child process id is stored in a global registry so the frontend can
+//!   cancel a running download.
+//! - Output file name is `Artist - Title.ext`, which is exactly the convention
+//!   `LibraryScanner::parse_filename` understands.
+
+use log::{info, warn};
+use serde::Serialize;
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+use std::process::Stdio;
+use std::sync::{Mutex, OnceLock};
+use std::time::{SystemTime, UNIX_EPOCH};
+use std::time::Instant;
+
+use tauri::{AppHandle, Emitter, Runtime};
+use tokio::io::{AsyncBufReadExt, BufReader};
+use tokio::process::Command;
+
+use super::ytdlp::{find_ytdlp_path, get_expanded_path};
+
+pub const DOWNLOAD_PROGRESS_EVENT: &str = "download:progress";
+
+#[derive(Debug, Clone, Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DownloadProgress {
+    pub download_id: String,
+    pub video_id: String,
+    pub title: String,
+    /// queued | downloading | completed | failed | cancelled
+    pub status: String,
+    pub percent: f64,
+    pub speed: String,
+    pub eta: String,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub error: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub file_path: Option<String>,
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub needs_restart: Option<bool>,
+}
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Quality {
+    Best1080,
+    P720,
+    AudioOnly,
+}
+
+impl Quality {
+    pub fn from_str(value: &str) -> Self {
+        match value {
+            "720p" => Quality::P720,
+            "audio" => Quality::AudioOnly,
+            _ => Quality::Best1080,
+        }
+    }
+
+    pub fn as_str(&self) -> &'static str {
+        match self {
+            Quality::Best1080 => "1080p",
+            Quality::P720 => "720p",
+            Quality::AudioOnly => "audio",
+        }
+    }
+
+    pub fn format_selector(&self) -> &'static str {
+        match self {
+            Quality::Best1080 => concat!(
+                "bv*[ext=mp4][vcodec^=avc1][height<=1080]+ba[ext=m4a]/",
+                "bv*[height<=1080]+ba/b[ext=mp4]/b"
+            ),
+            Quality::P720 => concat!(
+                "bv*[ext=mp4][vcodec^=avc1][height<=720]+ba[ext=m4a]/",
+                "b[ext=mp4][height<=720]/b[ext=mp4]/b"
+            ),
+            Quality::AudioOnly => "ba[ext=m4a]/ba",
+        }
+    }
+
+    pub fn is_audio(&self) -> bool {
+        matches!(self, Quality::AudioOnly)
+    }
+}
+
+/// Registry of running yt-dlp processes so downloads can be cancelled.
+#[derive(Default)]
+pub struct DownloadManager {
+    pids: Mutex<HashMap<String, u32>>,
+}
+
+impl DownloadManager {
+    pub fn new() -> Self {
+        Self::default()
+    }
+
+    fn register(&self, id: &str, pid: u32) {
+        if let Ok(mut map) = self.pids.lock() {
+            map.insert(id.to_string(), pid);
+        }
+    }
+
+    fn unregister(&self, id: &str) {
+        if let Ok(mut map) = self.pids.lock() {
+            map.remove(id);
+        }
+    }
+
+    pub fn is_running(&self, id: &str) -> bool {
+        self.pids
+            .lock()
+            .map(|map| map.contains_key(id))
+            .unwrap_or(false)
+    }
+
+    /// Send SIGTERM to the yt-dlp process of `id`. Returns true when a process
+    /// was found and signalled.
+    pub fn cancel(&self, id: &str) -> bool {
+        let pid = self.pids.lock().ok().and_then(|mut map| map.remove(id));
+        match pid {
+            Some(pid) => std::process::Command::new("kill")
+                .arg("-TERM")
+                .arg(pid.to_string())
+                .status()
+                .map(|s| s.success())
+                .unwrap_or(false),
+            None => false,
+        }
+    }
+}
+
+/// One download at a time. Parallel yt-dlp processes fetching the same channel
+/// in bursts is what gets the media CDN to answer 403.
+fn download_lock() -> &'static tokio::sync::Mutex<()> {
+    static LOCK: OnceLock<tokio::sync::Mutex<()>> = OnceLock::new();
+    LOCK.get_or_init(|| tokio::sync::Mutex::new(()))
+}
+
+/// Downloads the user asked for explicitly; they jump ahead of prefetching.
+static USER_WAITING: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum Priority {
+    /// A click in the UI — never waits behind background work.
+    User,
+    /// Prefetch for the next songs; politely yields to user downloads.
+    Background,
+}
+
+impl Priority {
+    pub fn from_str(value: Option<&str>) -> Self {
+        match value {
+            Some("background") => Priority::Background,
+            _ => Priority::User,
+        }
+    }
+}
+
+/// Acquire the single download slot.
+///
+/// Background work only takes the slot while no user download is waiting, so a
+/// prefetch run can never make a clicked download sit through three songs.
+struct UserWaiter;
+impl UserWaiter {
+    fn new() -> Self {
+        USER_WAITING.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        Self
+    }
+}
+impl Drop for UserWaiter {
+    fn drop(&mut self) {
+        USER_WAITING.fetch_sub(1, std::sync::atomic::Ordering::SeqCst);
+    }
+}
+
+async fn acquire_slot(priority: Priority) -> tokio::sync::OwnedMutexGuard<()> {
+    use std::sync::atomic::Ordering;
+    use std::sync::Arc;
+
+    static LOCK: OnceLock<Arc<tokio::sync::Mutex<()>>> = OnceLock::new();
+    let lock = LOCK.get_or_init(|| Arc::new(tokio::sync::Mutex::new(()))).clone();
+
+    match priority {
+        Priority::User => {
+            let _waiter = UserWaiter::new();
+            let guard = lock.lock_owned().await;
+            guard
+        }
+        Priority::Background => {
+            // try for up to 10 minutes, backing off while user downloads wait
+            for _ in 0..300 {
+                if USER_WAITING.load(Ordering::SeqCst) == 0 {
+                    if let Ok(guard) = lock.clone().try_lock_owned() {
+                        return guard;
+                    }
+                }
+                tokio::time::sleep(std::time::Duration::from_secs(2)).await;
+            }
+            // give up yielding and just queue normally
+            lock.lock_owned().await
+        }
+    }
+}
+
+/// Global manager — one per process, no extra AppState plumbing needed.
+pub fn manager() -> &'static DownloadManager {
+    static MANAGER: OnceLock<DownloadManager> = OnceLock::new();
+    MANAGER.get_or_init(DownloadManager::new)
+}
+
+pub fn new_download_id() -> String {
+    let ms = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_millis())
+        .unwrap_or(0);
+    format!("dl-{}", ms)
+}
+
+fn sanitize(part: &str) -> String {
+    let cleaned: String = part
+        .chars()
+        .map(|c| match c {
+            '/' | '\\' | ':' | '*' | '?' | '"' | '<' | '>' | '|' => '_',
+            c if (c as u32) < 0x20 => '_',
+            c => c,
+        })
+        .collect();
+    let trimmed = cleaned.trim().trim_matches('.').to_string();
+    if trimmed.is_empty() {
+        "karaoke".to_string()
+    } else {
+        trimmed.chars().take(120).collect()
+    }
+}
+
+/// `Artist - Title` when we know the artist, plain title otherwise — this is the
+/// pattern the library scanner splits on.
+pub fn output_stem(title: &str, artist: Option<&str>) -> String {
+    let title = sanitize(title);
+    let artist = artist.map(str::trim).filter(|a| !a.is_empty()).map(sanitize);
+    match artist {
+        Some(artist) => {
+            // YouTube titles very often already read "Artist - Song"; prefixing the
+            // channel name again would produce "Artist - Artist - Song".
+            let lower_title = title.to_lowercase();
+            let already_names_artist =
+                lower_title.contains(" - ") || lower_title.starts_with(&artist.to_lowercase());
+            if already_names_artist {
+                title
+            } else {
+                format!("{} - {}", artist, title)
+                    .chars()
+                    .take(150)
+                    .collect()
+            }
+        }
+        None => title,
+    }
+}
+
+/// Parse one yt-dlp progress line: `[download]  42.3% of ~12.34MiB at 1.2MiB/s ETA 00:05`.
+/// Returns (percent, speed, eta).
+pub fn parse_progress(line: &str) -> Option<(f64, String, String)> {
+    if !line.starts_with("[download]") {
+        return None;
+    }
+    let percent_at = line.find('%')?;
+    let before = &line[..percent_at];
+    let digits: String = before
+        .chars()
+        .rev()
+        .take_while(|c| c.is_ascii_digit() || *c == '.')
+        .collect::<String>()
+        .chars()
+        .rev()
+        .collect();
+    let percent: f64 = digits.parse().ok()?;
+
+    let mut speed = String::new();
+    let mut eta = String::new();
+    if let Some(at) = line.find(" at ") {
+        let rest = &line[at + 4..];
+        let token = rest.split_whitespace().next().unwrap_or("");
+        if token.contains("/s") {
+            speed = token.to_string();
+        }
+    }
+    if let Some(eta_at) = line.find("ETA ") {
+        let rest = &line[eta_at + 4..];
+        eta = rest.split_whitespace().next().unwrap_or("").to_string();
+    }
+    Some((percent, speed, eta))
+}
+
+/// Locate the file yt-dlp just produced (or reused, when it skipped an existing file).
+pub fn find_output(dir: &Path, stem: &str) -> Option<PathBuf> {
+    const ALLOWED: [&str; 8] = ["mp4", "mkv", "webm", "mov", "m4a", "mp3", "opus", "flac"];
+    let entries = std::fs::read_dir(dir).ok()?;
+    let mut best: Option<(SystemTime, PathBuf)> = None;
+    for entry in entries.flatten() {
+        let path = entry.path();
+        let Some(name) = path.file_name().map(|n| n.to_string_lossy().to_string()) else {
+            continue;
+        };
+        // 精确匹配 "<stem>.<ext>"：前缀匹配会把 "稻香" 误判成 "稻香 (live).mp4"
+        let Some((base, ext)) = name.rsplit_once('.') else {
+            continue;
+        };
+        if base != stem || !ALLOWED.contains(&ext.to_lowercase().as_str()) {
+            continue;
+        }
+        let modified = entry
+            .metadata()
+            .and_then(|m| m.modified())
+            .unwrap_or(UNIX_EPOCH);
+        if best.as_ref().map(|(t, _)| modified > *t).unwrap_or(true) {
+            best = Some((modified, path));
+        }
+    }
+    best.map(|(_, p)| p)
+}
+
+fn emit_progress<R: Runtime>(app: &AppHandle<R>, payload: DownloadProgress) {
+    let _ = app.emit(DOWNLOAD_PROGRESS_EVENT, payload);
+}
+
+/// Build the yt-dlp argument list. Exposed for tests.
+/// Cookie source: either a browser name (yt-dlp `--cookies-from-browser`) or a
+/// Netscape cookies.txt file. YouTube's "Sign in to confirm you're not a bot"
+/// challenge only goes away with an authenticated session.
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub enum CookieSource {
+    None,
+    Browser(String),
+    File(String),
+}
+
+impl CookieSource {
+    pub fn from_settings(browser: Option<String>, file: Option<String>) -> Self {
+        if let Some(path) = file.map(|p| p.trim().to_string()).filter(|p| !p.is_empty()) {
+            return CookieSource::File(path);
+        }
+        let lowered = browser.as_deref().map(|b| b.trim().to_lowercase());
+        match lowered.as_deref() {
+            Some("safari") | Some("chrome") | Some("edge") | Some("firefox") | Some("brave") => {
+                CookieSource::Browser(lowered.unwrap())
+            }
+            _ => CookieSource::None,
+        }
+    }
+
+    pub fn as_label(&self) -> String {
+        match self {
+            CookieSource::None => "none".to_string(),
+            CookieSource::Browser(name) => name.clone(),
+            CookieSource::File(path) => format!("file:{}", path),
+        }
+    }
+}
+
+pub fn build_args(
+    video_id: &str,
+    dir: &Path,
+    stem: &str,
+    quality: Quality,
+    cookies: &CookieSource,
+    robust: bool,
+    pot_base: Option<&str>,
+    client: Option<&str>,
+    forced_format: Option<&str>,
+) -> Vec<String> {
+    let url = format!("https://www.youtube.com/watch?v={}", video_id);
+    let out_template = dir.join(format!("{}.%(ext)s", stem));
+    let mut args: Vec<String> = vec![
+        "--no-playlist".into(),
+        "--newline".into(),
+        "--no-warnings".into(),
+        "--retries".into(),
+        "5".into(),
+        "--fragment-retries".into(),
+        "5".into(),
+    ];
+
+    if robust {
+        // 稳健模式：把「十几路突发」压成「单路持续」，这是 403 的主因
+        args.extend([
+            "--concurrent-fragments".into(),
+            "1".into(),
+            "--http-chunk-size".into(),
+            "10M".into(),
+            "--sleep-interval".into(),
+            "2".into(),
+            "--sleep-requests".into(),
+            "1".into(),
+        ]);
+    } else {
+        args.extend(["--concurrent-fragments".into(), "4".into()]);
+    }
+
+    args.extend([
+        "-o".into(),
+        out_template.to_string_lossy().to_string(),
+        "-f".into(),
+        forced_format
+            .map(|f| f.to_string())
+            .unwrap_or_else(|| quality.format_selector().to_string()),
+    ]);
+
+    // 客户端轮换：默认客户端对 DASH 格式会中途 403，web_safari / mweb 目前可过
+    if let Some(client) = client {
+        args.extend([
+            "--extractor-args".into(),
+            format!("youtube:player_client={client}"),
+        ]);
+    }
+
+    if quality.is_audio() {
+        args.extend(["-x".into(), "--audio-format".into(), "m4a".into()]);
+    } else {
+        args.extend([
+            "--merge-output-format".into(),
+            "mp4".into(),
+            "--embed-metadata".into(),
+            "--embed-thumbnail".into(),
+        ]);
+    }
+
+    // PO Token provider（bgutil）在跑就用它，web 系客户端的 403 会明显减少
+    if let Some(base) = pot_base {
+        args.extend([
+            "--extractor-args".into(),
+            format!("youtubepot-bgutilhttp:base_url={}", base),
+        ]);
+    }
+
+    match cookies {
+        CookieSource::Browser(name) => {
+            args.push("--cookies-from-browser".into());
+            args.push(name.clone());
+        }
+        CookieSource::File(path) => {
+            args.push("--cookies".into());
+            args.push(path.clone());
+        }
+        CookieSource::None => {}
+    }
+
+    if let Some(ffmpeg) = super::ytdlp::find_executable_in_path("ffmpeg") {
+        if let Some(parent) = ffmpeg.parent() {
+            args.push("--ffmpeg-location".into());
+            args.push(parent.to_string_lossy().to_string());
+        }
+    }
+    args.push(url);
+    args
+}
+
+// ---------------------------------------------------------------- 断路器
+
+use std::sync::atomic::{AtomicU64, Ordering};
+
+const COOLDOWN_SECS: u64 = 900;
+const TRIP_WINDOW_SECS: u64 = 300;
+const TRIP_THRESHOLD: usize = 3;
+
+static COOLDOWN_UNTIL: AtomicU64 = AtomicU64::new(0);
+static FAIL_TIMES: OnceLock<Mutex<Vec<u64>>> = OnceLock::new();
+
+fn now_secs() -> u64 {
+    SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0)
+}
+
+/// Seconds left in the global cool-down, 0 when healthy.
+pub fn cooldown_remaining() -> u64 {
+    let until = COOLDOWN_UNTIL.load(Ordering::SeqCst);
+    let now = now_secs();
+    if until > now {
+        until - now
+    } else {
+        0
+    }
+}
+
+/// Record a 403; three inside five minutes trips the global breaker, because
+/// hammering a throttled edge only raises the bar.
+pub fn record_403() {
+    let times = FAIL_TIMES.get_or_init(|| Mutex::new(Vec::new()));
+    let now = now_secs();
+    if let Ok(mut list) = times.lock() {
+        list.push(now);
+        list.retain(|t| now.saturating_sub(*t) <= TRIP_WINDOW_SECS);
+        if list.len() >= TRIP_THRESHOLD {
+            COOLDOWN_UNTIL.store(now + COOLDOWN_SECS, Ordering::SeqCst);
+            list.clear();
+        }
+    }
+}
+
+static INFLIGHT: OnceLock<Mutex<HashMap<String, String>>> = OnceLock::new();
+
+fn inflight_map() -> &'static Mutex<HashMap<String, String>> {
+    INFLIGHT.get_or_init(|| Mutex::new(HashMap::new()))
+}
+
+/// A download for this video is already running → return its id so the caller
+/// does not spawn a second yt-dlp for the same song.
+pub fn inflight_for(video_id: &str) -> Option<String> {
+    inflight_map()
+        .lock()
+        .ok()
+        .and_then(|map| map.get(video_id).cloned())
+}
+
+pub fn mark_inflight(video_id: &str, download_id: &str) {
+    if let Ok(mut map) = inflight_map().lock() {
+        map.insert(video_id.to_string(), download_id.to_string());
+    }
+}
+
+pub fn clear_inflight(video_id: &str) {
+    if let Ok(mut map) = inflight_map().lock() {
+        map.remove(video_id);
+    }
+}
+
+/// Detected PO token provider (bgutil HTTP server on 127.0.0.1:4416).
+pub fn pot_base_url() -> Option<String> {
+    use std::net::{TcpStream, ToSocketAddrs};
+    use std::time::Duration;
+    let addr = "127.0.0.1:4416".to_socket_addrs().ok()?.next()?;
+    match TcpStream::connect_timeout(&addr, Duration::from_millis(300)) {
+        Ok(_) => Some("http://127.0.0.1:4416".to_string()),
+        Err(_) => None,
+    }
+}
+
+/// 403 retry ladder: 8s → 30s → 120s.
+const RETRY_DELAYS: [u64; 3] = [8, 30, 120];
+
+/// Run one download to completion, emitting progress events.
+pub async fn download<R: Runtime>(
+    app: AppHandle<R>,
+    download_id: String,
+    video_id: String,
+    title: String,
+    artist: Option<String>,
+    dir: PathBuf,
+    quality: Quality,
+    cookies: CookieSource,
+    priority: Priority,
+    robust: bool,
+) -> Result<PathBuf, String> {
+    let Some(ytdlp) = find_ytdlp_path() else {
+        clear_inflight(&video_id);
+        emit_progress(
+            &app,
+            DownloadProgress {
+                download_id,
+                video_id,
+                title,
+                status: "failed".into(),
+                percent: 0.0,
+                speed: String::new(),
+                eta: String::new(),
+                error: Some("yt-dlp 未安装".into()),
+                file_path: None,
+                needs_restart: None,
+            },
+        );
+        return Err("yt-dlp not found".into());
+    };
+
+    std::fs::create_dir_all(&dir).map_err(|e| format!("创建下载目录失败: {e}"))?;
+    let stem = output_stem(&title, artist.as_deref());
+
+    // 排队：拿到全局锁之前，前端保持「排队中」
+    info!("download[{download_id}]: waiting for slot ({priority:?})");
+    let _serial = acquire_slot(priority).await;
+    info!("download[{download_id}]: slot acquired");
+    let _ = download_lock();
+
+    let pot_base = pot_base_url();
+
+    // 403 阶梯：默认客户端 → web_safari → mweb → 保底渐进式格式(360p)
+    // 实测（2026-10）：默认 web 客户端下载 DASH 格式约 5MB 后必 403，
+    // web_safari / mweb 可正常取全流；最后用 muxed 18 号格式兜底保证有文件。
+    // 保底格式要跟着质量走：音频模式退到 ba/b，视频模式退到 muxed 18
+    let fallback_format = if quality.is_audio() { "ba/b" } else { "18/b" };
+    let strategies: [(Option<&str>, Option<&str>, &str); 4] = [
+        (None, None, "默认客户端"),
+        (Some("web_safari"), None, "web_safari"),
+        (Some("mweb"), None, "mweb"),
+        (Some("web_safari"), Some(fallback_format), "保底格式"),
+    ];
+
+    let mut last_error = String::new();
+    for (idx, (client, forced_format, label)) in strategies.iter().enumerate() {
+        emit_progress(
+            &app,
+            DownloadProgress {
+                download_id: download_id.clone(),
+                video_id: video_id.clone(),
+                title: title.clone(),
+                status: "downloading".into(),
+                percent: 0.0,
+                speed: if idx == 0 {
+                    String::new()
+                } else {
+                    format!("换策略 {}/{}：{}", idx + 1, strategies.len(), label)
+                },
+                eta: String::new(),
+                error: None,
+                file_path: None,
+                needs_restart: None,
+            },
+        );
+
+        let args = build_args(
+            &video_id,
+            &dir,
+            &stem,
+            quality,
+            &cookies,
+            robust,
+            pot_base.as_deref(),
+            *client,
+            *forced_format,
+        );
+
+        info!(
+            "download[{download_id}]: attempt {}/{} with {}",
+            idx + 1,
+            strategies.len(),
+            label
+        );
+
+        let outcome = match tokio::time::timeout(
+            std::time::Duration::from_secs(15 * 60),
+            run_ytdlp(&app, &ytdlp, &args, &download_id, &video_id, &title),
+        )
+        .await
+        {
+            Ok(result) => result,
+            Err(_) => {
+                manager().cancel(&download_id);
+                emit_progress(
+                    &app,
+                    DownloadProgress {
+                        download_id: download_id.clone(),
+                        video_id: video_id.clone(),
+                        title: title.clone(),
+                        status: "failed".into(),
+                        percent: 0.0,
+                        speed: String::new(),
+                        eta: String::new(),
+                        error: Some("下载超时（15 分钟），已终止".into()),
+                        file_path: None,
+                        needs_restart: None,
+                    },
+                );
+                clear_inflight(&video_id);
+                return Err("下载超时（15 分钟），已终止".to_string());
+            }
+        };
+        let (status, stderr_lines) = outcome;
+
+        if status.success() {
+            clear_inflight(&video_id);
+            let path = find_output(&dir, &stem)
+                .ok_or_else(|| "yt-dlp 结束但没有产出文件".to_string())?;
+            let done_path = path.to_string_lossy().to_string();
+            emit_progress(
+                &app,
+                DownloadProgress {
+                    download_id: download_id.clone(),
+                    video_id: video_id.clone(),
+                    title: title.clone(),
+                    status: "completed".into(),
+                    percent: 100.0,
+                    speed: String::new(),
+                    eta: String::new(),
+                    error: None,
+                    file_path: Some(done_path),
+                    needs_restart: None,
+                },
+            );
+            info!("download[{download_id}]: done via {label} -> {:?}", path);
+            return Ok(path);
+        }
+
+        let joined = stderr_lines.join(" | ");
+        let is_403 = joined.contains("403");
+        let is_bot = joined.contains("Sign in to confirm");
+        last_error = stderr_lines
+            .last()
+            .cloned()
+            .unwrap_or_else(|| format!("yt-dlp 退出码 {:?}", status.code()));
+        warn!("download[{download_id}]: attempt {label} failed: {last_error}");
+
+        eprintln!("[downloader] attempt {label} failed: {last_error}");
+
+        // bot 校验换客户端也没用，直接结束；其余（403 / 该客户端没有这个格式）都继续下一策略
+        if is_bot || joined.contains("Video unavailable") || joined.contains("Private video") {
+            break;
+        }
+        tokio::time::sleep(std::time::Duration::from_secs(3)).await;
+    }
+
+    // 所有策略都失败：记一次 403 并上报
+    record_403();
+    clear_inflight(&video_id);
+    let breaker = cooldown_remaining();
+    let detail = if breaker > 0 {
+        format!("{last_error}（403 过多，已进入冷却 {} 秒）", breaker)
+    } else {
+        last_error
+    };
+    emit_progress(
+        &app,
+        DownloadProgress {
+            download_id,
+            video_id,
+            title,
+            status: "failed".into(),
+            percent: 0.0,
+            speed: String::new(),
+            eta: String::new(),
+            error: Some(detail.clone()),
+            file_path: None,
+            needs_restart: None,
+        },
+    );
+    Err(detail)
+}
+
+/// Run yt-dlp once, streaming progress events; returns (status, stderr tail).
+async fn run_ytdlp<R: Runtime>(
+    app: &AppHandle<R>,
+    ytdlp: &Path,
+    args: &[String],
+    download_id: &str,
+    video_id: &str,
+    title: &str,
+) -> (std::process::ExitStatus, Vec<String>) {
+    let mut command = Command::new(ytdlp);
+    command
+        .args(args)
+        .env("PATH", get_expanded_path())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::piped());
+
+    let mut child = match command.spawn() {
+        Ok(child) => child,
+        Err(err) => {
+            // 用一个假的失败状态返回，调用方按 stderr 文本处理
+            let line = format!("启动 yt-dlp 失败: {err}");
+            return (
+                std::process::Command::new("/usr/bin/false")
+                    .status()
+                    .unwrap_or_else(|_| std::process::exit(1)),
+                vec![line],
+            );
+        }
+    };
+
+    if let Some(pid) = child.id() {
+        manager().register(download_id, pid);
+    }
+
+    let stderr = child.stderr.take();
+    let stderr_task = tauri::async_runtime::spawn(async move {
+        let mut collected = Vec::new();
+        if let Some(stderr) = stderr {
+            let mut reader = BufReader::new(stderr).lines();
+            while let Ok(Some(line)) = reader.next_line().await {
+                if !line.trim().is_empty() {
+                    collected.push(line);
+                    if collected.len() > 20 {
+                        collected.remove(0);
+                    }
+                }
+            }
+        }
+        collected
+    });
+
+    if let Some(stdout) = child.stdout.take() {
+        let mut reader = BufReader::new(stdout).lines();
+        let mut last_emit = Instant::now();
+        while let Ok(Some(line)) = reader.next_line().await {
+            if let Some((percent, speed, eta)) = parse_progress(&line) {
+                if last_emit.elapsed().as_millis() >= 250 || percent >= 100.0 {
+                    last_emit = Instant::now();
+                    emit_progress(
+                        app,
+                        DownloadProgress {
+                            download_id: download_id.to_string(),
+                            video_id: video_id.to_string(),
+                            title: title.to_string(),
+                            status: "downloading".into(),
+                            percent,
+                            speed,
+                            eta,
+                            error: None,
+                            file_path: None,
+                            needs_restart: None,
+                        },
+                    );
+                }
+            }
+        }
+    }
+
+    let status = match child.wait().await {
+        Ok(status) => status,
+        Err(err) => {
+            manager().unregister(download_id);
+            let lines = stderr_task.await.unwrap_or_default();
+            return (
+                std::process::Command::new("/usr/bin/false")
+                    .status()
+                    .unwrap_or_else(|_| std::process::exit(1)),
+                {
+                    let mut lines = lines;
+                    lines.push(format!("等待 yt-dlp 结束失败: {err}"));
+                    lines
+                },
+            );
+        }
+    };
+    manager().unregister(download_id);
+    let lines = stderr_task.await.unwrap_or_default();
+    (status, lines)
+}
+
