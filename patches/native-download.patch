+import { create } from "zustand";
+import { downloadService, createLogger, type DownloadInfo, type DownloadProgress } from "../services";
+import { notify } from "./notificationStore";
+import { usePrefetchStore } from "./prefetchStore";
+
+const log = createLogger("DownloadStore");
+
+export interface DownloadItem {
+  downloadId: string;
+  silent?: boolean;
+  videoId: string;
+  title: string;
+  status: DownloadProgress["status"];
+  percent: number;
+  speed: string;
+  eta: string;
+  error?: string;
+  filePath?: string;
+  needsRestart?: boolean;
+}
+
+interface DownloadState {
+  items: Record<string, DownloadItem>;
+  initialized: boolean;
+  /** Resolved destination folder + quality, shown in the panel. */
+  info: DownloadInfo | null;
+  /** Subscribe to backend progress events (idempotent). */
+  init: () => Promise<void>;
+  start: (params: {
+    videoId: string;
+    title: string;
+    artist?: string;
+    quality?: "1080p" | "720p" | "audio";
+    silent?: boolean;
+    priority?: "user" | "background";
+  }) => Promise<void>;
+  cancel: (downloadId: string) => Promise<void>;
+  clearFinished: () => void;
+  remove: (downloadId: string) => void;
+  setCookies: (cookies: string) => Promise<void>;
+  setRobust: (enabled: boolean) => Promise<void>;
+  refreshInfo: () => Promise<void>;
+}
+
+let unlisten: (() => void) | null = null;
+
+export const useDownloadStore = create<DownloadState>((set, get) => ({
+  items: {},
+  initialized: false,
+  info: null,
+
+  init: async () => {
+    if (unlisten) return;
+    try {
+      const info = await downloadService.info();
+      set({ info });
+    } catch (err) {
+      log.warn(`download_info failed: ${err instanceof Error ? err.message : err}`);
+    }
+    unlisten = await downloadService.onProgress((progress) => {
+      const existing = get().items[progress.downloadId];
+      const item: DownloadItem = {
+        downloadId: progress.downloadId,
+        silent: existing?.silent,
+        videoId: progress.videoId,
+        title: progress.title,
+        status: progress.status,
+        percent: progress.percent,
+        speed: progress.speed,
+        eta: progress.eta,
+        error: progress.error,
+        filePath: progress.filePath,
+        needsRestart: progress.needsRestart ?? existing?.needsRestart,
+      };
+      set((state) => ({ items: { ...state.items, [item.downloadId]: item } }));
+
+      const prefetch = usePrefetchStore.getState();
+      if (progress.status === "completed") {
+        if (progress.filePath) prefetch.prime(progress.videoId, progress.filePath);
+        else prefetch.release(progress.videoId);
+      } else if (progress.status === "failed") {
+        prefetch.release(progress.videoId);
+      }
+
+      if (progress.status === "completed" && !existing?.silent) {
+        log.info(`downloaded: ${progress.filePath ?? progress.title}`);
+        notify(
+          "success",
+          progress.needsRestart
+            ? `已下载 ${progress.title}（重启 HomeKaraoke 后可在 Local 里播放）`
+            : `已下载 ${progress.title} → Local 曲库`
+        );
+      }
+      if (progress.status === "failed" && !existing?.silent) {
+        log.warn(`download failed: ${progress.error}`);
+        const raw = progress.error ?? "";
+        const friendly = raw.includes("Sign in to confirm")
+          ? "YouTube 要求登录验证（机器人检测）：在下载面板里把 Cookie 选成 Chrome/Safari 再重试"
+          : raw.includes("not found in any common locations") || raw.includes("yt-dlp 未安装")
+          ? "找不到 yt-dlp：请先安装 yt-dlp"
+          : raw || progress.title;
+        notify("error", `下载失败：${friendly}`);
+        void get().refreshInfo();
+      }
+    });
+    set({ initialized: true });
+  },
+
+  start: async (params) => {
+    log.info(`start requested: ${params.videoId} (${params.silent ? "prefetch" : "user"})`);
+    try {
+      const downloadId = await downloadService.start(params);
+      set((state) => ({
+        items: {
+          ...state.items,
+          [downloadId]: {
+            downloadId,
+            silent: params.silent,
+            videoId: params.videoId,
+            title: params.title,
+            status: "queued",
+            percent: 0,
+            speed: "",
+            eta: "",
+          },
+        },
+      }));
+    } catch (err) {
+      const message = err instanceof Error ? err.message : String(err);
+      log.warn(`start failed: ${message}`);
+      notify("error", `无法开始下载：${message}`);
+    }
+  },
+
+  cancel: async (downloadId) => {
+    await downloadService.cancel(downloadId);
+    set((state) => {
+      const item = state.items[downloadId];
+      if (!item) return state;
+      return {
+        items: {
+          ...state.items,
+          [downloadId]: { ...item, status: "cancelled", speed: "", eta: "" },
+        },
+      };
+    });
+  },
+
+  clearFinished: () =>
+    set((state) => {
+      const items: Record<string, DownloadItem> = {};
+      for (const [id, item] of Object.entries(state.items)) {
+        if (item.status === "downloading" || item.status === "queued") {
+          items[id] = item;
+        }
+      }
+      return { items };
+    }),
+
+  refreshInfo: async () => {
+    try {
+      const info = await downloadService.info();
+      set({ info });
+    } catch {
+      /* backend not ready yet */
+    }
+  },
+
+  setRobust: async (enabled) => {
+    await downloadService.setRobust(enabled);
+    const info = await downloadService.info();
+    set({ info });
+    log.info(`robust mode: ${enabled}`);
+  },
+
+  setCookies: async (cookies) => {
+    await downloadService.setCookies(cookies);
+    const info = await downloadService.info();
+    set({ info });
+    log.info(`cookie source: ${cookies}`);
+  },
+
+  remove: (downloadId) =>
+    set((state) => {
+      const items = { ...state.items };
+      delete items[downloadId];
+      return { items };
+    }),
+}));
