@@ -0,0 +1,526 @@
+//! Download commands — download a YouTube song into the local library.
+//!
+//! `youtube_download` returns immediately with a download id; progress arrives
+//! through the `download:progress` event emitted by the downloader service.
+
+use std::path::PathBuf;
+
+use log::{debug, info, warn};
+use tauri::{AppHandle, Manager, State};
+
+use crate::commands::errors::CommandError;
+use crate::db::Database;
+use crate::services::downloader::{self, CookieSource, Priority, Quality};
+use crate::services::{LibraryFolder, LibraryScanner, ScanOptions};
+use crate::AppState;
+
+/// Resolve the download folder: `download_dir` setting, else `<audio>/HomeKaraoke`.
+fn resolve_download_dir(state: &AppState, app: &AppHandle) -> Result<PathBuf, CommandError> {
+    // 1) explicit setting wins
+    let (configured, first_library_folder) = {
+        let db = state
+            .db
+            .lock()
+            .map_err(|_| CommandError::DatabaseLock("download_dir".into()))?;
+        let configured = db.get_setting("download_dir").ok().flatten();
+        let folder = db
+            .connection()
+            .query_row(
+                "SELECT path FROM library_folders ORDER BY id LIMIT 1",
+                [],
+                |row| row.get::<_, String>(0),
+            )
+            .ok();
+        (configured, folder)
+    };
+
+    if let Some(dir) = configured.filter(|d| !d.trim().is_empty()) {
+        info!("download dir: {} (from setting)", dir);
+        return Ok(PathBuf::from(dir));
+    }
+
+    // 2) otherwise stay inside the library the app already knows about, so a
+    //    downloaded song lands exactly where the Local tab looks for it
+    if let Some(folder) = first_library_folder.filter(|p| !p.trim().is_empty()) {
+        info!("download dir: {} (from library folder)", folder);
+        return Ok(PathBuf::from(folder));
+    }
+
+    // 3) last resort: <audio>/HomeKaraoke
+    let base = app
+        .path()
+        .audio_dir()
+        .map_err(|e| CommandError::External(format!("无法定位音乐目录: {e}")))?;
+    let fallback = base.join("HomeKaraoke");
+    info!("download dir: {} (default)", fallback.display());
+    Ok(fallback)
+}
+
+fn resolve_quality(state: &AppState) -> Quality {
+    let value = state
+        .db
+        .lock()
+        .ok()
+        .and_then(|db| db.get_setting("download_quality").ok().flatten());
+    Quality::from_str(value.as_deref().unwrap_or("1080p"))
+}
+
+fn resolve_robust(state: &AppState) -> bool {
+    match state.db.lock() {
+        Ok(db) => db
+            .get_setting("download_robust")
+            .ok()
+            .flatten()
+            .map(|v| v != "false")
+            .unwrap_or(true),
+        Err(_) => true,
+    }
+}
+
+fn resolve_cookies(state: &AppState) -> CookieSource {
+    let (browser, file) = match state.db.lock() {
+        Ok(db) => (
+            db.get_setting("download_cookies").ok().flatten(),
+            db.get_setting("download_cookies_file").ok().flatten(),
+        ),
+        Err(_) => (None, None),
+    };
+    let source = CookieSource::from_settings(browser, file);
+    info!("download cookies: {}", source.as_label());
+    source
+}
+
+/// Make sure HomeKaraoke knows about the folder (also feeds the asset:// scope
+/// on the next app start). Returns true when the folder is new.
+fn ensure_library_folder(state: &AppState, dir: &PathBuf) -> Result<bool, CommandError> {
+    let path = dir.to_string_lossy().to_string();
+    let name = dir
+        .file_name()
+        .map(|n| n.to_string_lossy().to_string())
+        .unwrap_or_else(|| path.clone());
+    let db = state
+        .db
+        .lock()
+        .map_err(|_| CommandError::DatabaseLock("library_folders".into()))?;
+    let conn = db.connection();
+    let existing: Option<i64> = conn
+        .query_row(
+            "SELECT id FROM library_folders WHERE path = ?1",
+            [&path],
+            |row| row.get(0),
+        )
+        .ok();
+    if existing.is_some() {
+        return Ok(false);
+    }
+    conn.execute(
+        "INSERT INTO library_folders (path, name) VALUES (?1, ?2)",
+        rusqlite::params![path, name],
+    )?;
+    Ok(true)
+}
+
+/// Register the finished file in `videos` so it shows up in Local straight away.
+fn register_video(
+    state: &AppState,
+    file_path: &str,
+    video_id: &str,
+    title: &str,
+    artist: Option<&str>,
+    quality: Quality,
+    download_id: &str,
+) -> Result<(), CommandError> {
+    let thumbnail = format!("https://i.ytimg.com/vi/{}/hqdefault.jpg", video_id);
+    let size = std::fs::metadata(file_path).map(|m| m.len() as i64).unwrap_or(0);
+    let db = state
+        .db
+        .lock()
+        .map_err(|_| CommandError::DatabaseLock("videos".into()))?;
+    let conn = db.connection();
+
+    let existing_id: Option<i64> = conn
+        .query_row(
+            "SELECT id FROM videos WHERE file_path = ?1",
+            [file_path],
+            |row| row.get(0),
+        )
+        .ok()
+        .or_else(|| {
+            conn.query_row(
+                "SELECT id FROM videos WHERE youtube_id = ?1",
+                [video_id],
+                |row| row.get(0),
+            )
+            .ok()
+        });
+
+    match existing_id {
+        Some(id) => {
+            conn.execute(
+                "UPDATE videos SET source_type='local', file_path=?1, title=?2,
+                 artist=COALESCE(NULLIF(?3,''), artist),
+                 thumbnail_url=COALESCE(thumbnail_url, ?4)
+                 WHERE id=?5",
+                rusqlite::params![file_path, title, artist.unwrap_or(""), thumbnail, id],
+            )?;
+        }
+        None => {
+            conn.execute(
+                "INSERT INTO videos (youtube_id, title, artist, source_type, file_path, thumbnail_url)
+                 VALUES (?1, ?2, ?3, 'local', ?4, ?5)",
+                rusqlite::params![video_id, title, artist, file_path, thumbnail],
+            )?;
+        }
+    }
+
+    conn.execute(
+        "INSERT INTO download_queue (youtube_id, youtube_title, status, progress_percent,
+             file_path, quality, file_size_bytes, download_id, completed_at)
+         VALUES (?1, ?2, 'completed', 100, ?3, ?4, ?5, ?6, CURRENT_TIMESTAMP)
+         ON CONFLICT(youtube_id) DO UPDATE SET status='completed', progress_percent=100,
+             file_path=?3, quality=?4, file_size_bytes=?5, download_id=?6,
+             error_message=NULL, completed_at=CURRENT_TIMESTAMP",
+        rusqlite::params![
+            video_id,
+            title,
+            file_path,
+            quality.as_str(),
+            size,
+            download_id
+        ],
+    )?;
+    Ok(())
+}
+
+/// Run the library scanner for the download folder so `.hkmeta.json` and
+/// thumbnails get generated by the normal pipeline.
+fn scan_after_download(state: &AppState, dir: &PathBuf) {
+    // 每首歌都全库扫一次太重：45 秒内只扫一次，避免批量下载时扫描堆积
+    {
+        use std::sync::{Mutex, OnceLock};
+        use std::time::{Duration, Instant};
+        static LAST_SCAN: OnceLock<Mutex<Option<Instant>>> = OnceLock::new();
+        let slot = LAST_SCAN.get_or_init(|| Mutex::new(None));
+        if let Ok(mut last) = slot.lock() {
+            if let Some(prev) = *last {
+                if prev.elapsed() < Duration::from_secs(45) {
+                    info!("post-download scan skipped (throttled)");
+                    return;
+                }
+            }
+            *last = Some(Instant::now());
+        }
+    }
+
+    let path = dir.to_string_lossy().to_string();
+    let folder = {
+        let Ok(db) = state.db.lock() else { return };
+        let conn = db.connection();
+        conn.query_row(
+            "SELECT id, path, COALESCE(name, path), last_scan_at, COALESCE(file_count, 0)
+             FROM library_folders WHERE path = ?1",
+            [&path],
+            |row| {
+                Ok(LibraryFolder {
+                    id: row.get(0)?,
+                    path: row.get(1)?,
+                    name: row.get(2)?,
+                    last_scan_at: row.get(3)?,
+                    file_count: row.get::<_, i64>(4)? as u32,
+                })
+            },
+        )
+        .ok()
+    };
+    let Some(folder) = folder else { return };
+    let options = ScanOptions {
+        create_hkmeta: true,
+        fetch_song_info: true,
+        fetch_lyrics: true,
+        regenerate: false,
+        generate_thumbnails: true,
+    };
+    let result = LibraryScanner::scan_folder(&folder, &options);
+    info!(
+        "post-download scan: {} files, {} hkmeta, {} thumbnails, {} errors",
+        result.files_found,
+        result.hkmeta_created,
+        result.thumbnails_generated,
+        result.errors.len()
+    );
+}
+
+#[tauri::command]
+pub async fn youtube_download(
+    app: AppHandle,
+    state: State<'_, AppState>,
+    video_id: String,
+    title: String,
+    artist: Option<String>,
+    quality: Option<String>,
+    priority: Option<String>,
+) -> Result<String, CommandError> {
+    debug!("youtube_download: video_id='{}'", video_id);
+
+    let dir = resolve_download_dir(&state, &app)?;
+    let quality = quality
+        .as_deref()
+        .map(Quality::from_str)
+        .unwrap_or_else(|| resolve_quality(&state));
+    let cookies = resolve_cookies(&state);
+    let task_priority = Priority::from_str(priority.as_deref());
+    let robust = resolve_robust(&state);
+    let cooldown = downloader::cooldown_remaining();
+    if cooldown > 0 {
+        match task_priority {
+            Priority::User => {
+                return Err(CommandError::External(format!(
+                    "403 次数过多，下载已冷却，还需等 {} 秒",
+                    cooldown
+                )))
+            }
+            // 预取在冷却期安静跳过，不要继续撞
+            Priority::Background => {
+                return Err(CommandError::External(format!(
+                    "冷却中（{} 秒），跳过预取",
+                    cooldown
+                )))
+            }
+        }
+    }
+
+    // 同一首已经在下载：直接复用它的 download_id，避免重复起 yt-dlp
+    if let Some(existing) = downloader::inflight_for(&video_id) {
+        debug!("youtube_download: '{}' already inflight as '{}'", video_id, existing);
+        return Ok(existing);
+    }
+    let needs_restart = ensure_library_folder(&state, &dir)?;
+    if needs_restart {
+        warn!(
+            "download folder {} registered for the first time — restart to play offline",
+            dir.display()
+        );
+    }
+
+    let download_id = downloader::new_download_id();
+    downloader::mark_inflight(&video_id, &download_id);
+    let id_for_task = download_id.clone();
+    let app_for_task = app.clone();
+    let dir_for_task = dir.clone();
+    let title_for_task = title.clone();
+    let artist_for_task = artist.clone();
+
+    tauri::async_runtime::spawn(async move {
+        let result = downloader::download(
+            app_for_task.clone(),
+            id_for_task.clone(),
+            video_id.clone(),
+            title_for_task.clone(),
+            artist_for_task.clone(),
+            dir_for_task.clone(),
+            quality,
+            cookies,
+            task_priority,
+            robust,
+        )
+        .await;
+
+        match result {
+            Ok(path) => {
+                let path_str = path.to_string_lossy().to_string();
+                info!("download completed: {}", path_str);
+                let state = app_for_task.state::<AppState>();
+                if let Err(err) = register_video(
+                    &state,
+                    &path_str,
+                    &video_id,
+                    &title_for_task,
+                    artist_for_task.as_deref(),
+                    quality,
+                    &id_for_task,
+                ) {
+                    warn!("failed to register downloaded video: {err}");
+                }
+                // 阻塞线程里跑扫描：scan_folder 内部会自建 tokio runtime
+                let dir_for_scan = dir_for_task.clone();
+                let app_for_scan = app_for_task.clone();
+                tauri::async_runtime::spawn_blocking(move || {
+                    let state = app_for_scan.state::<AppState>();
+                    scan_after_download(&state, &dir_for_scan);
+                })
+                .await
+                .ok();
+            }
+            Err(err) => {
+                warn!("download failed: {err}");
+                let state = app_for_task.state::<AppState>();
+                record_failure(&state, &video_id, &title_for_task, &err, &id_for_task);
+            }
+        }
+    });
+
+    Ok(download_id)
+}
+
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DownloadInfo {
+    pub dir: String,
+    pub quality: String,
+    pub cookies: String,
+    pub robust: bool,
+    pub pot: bool,
+    pub cooldown_seconds: u64,
+    pub library_folders: Vec<String>,
+}
+
+/// Where downloads go, and the quality currently used — surfaced in the UI so
+/// the folder is never a mystery.
+#[tauri::command]
+pub fn download_info(
+    app: AppHandle,
+    state: State<'_, AppState>,
+) -> Result<DownloadInfo, CommandError> {
+    let dir = resolve_download_dir(&state, &app)?;
+    let quality = resolve_quality(&state);
+    let cookies = resolve_cookies(&state);
+    let library_folders = {
+        let db = state
+            .db
+            .lock()
+            .map_err(|_| CommandError::DatabaseLock("library_folders".into()))?;
+        let conn = db.connection();
+        let mut stmt = conn.prepare("SELECT path FROM library_folders ORDER BY id")?;
+        let rows: Vec<String> = stmt
+            .query_map([], |row| row.get::<_, String>(0))?
+            .filter_map(|r| r.ok())
+            .collect();
+        rows
+    };
+    let _ = &app;
+    Ok(DownloadInfo {
+        dir: dir.to_string_lossy().to_string(),
+        quality: quality.as_str().to_string(),
+        cookies: cookies.as_label(),
+        robust: resolve_robust(&state),
+        pot: downloader::pot_base_url().is_some(),
+        cooldown_seconds: downloader::cooldown_remaining(),
+        library_folders,
+    })
+}
+
+/// Persist the cookie source used by yt-dlp (`none` | `safari` | `chrome` | ...,
+/// or `file:/abs/path/cookies.txt`).
+#[tauri::command]
+pub fn download_set_cookies(state: State<'_, AppState>, cookies: String) -> Result<(), CommandError> {
+    let value = cookies.trim().to_string();
+    let db = state
+        .db
+        .lock()
+        .map_err(|_| CommandError::DatabaseLock("download_cookies".into()))?;
+    if let Some(path) = value.strip_prefix("file:") {
+        db.set_setting("download_cookies_file", path)?;
+        db.set_setting("download_cookies", "none")?;
+    } else {
+        db.set_setting("download_cookies", &value)?;
+        db.set_setting("download_cookies_file", "")?;
+    }
+    info!("download cookies set to '{}'", value);
+    Ok(())
+}
+
+/// Local file already on disk for this YouTube id (used to play the prefetched
+/// next song straight from disk instead of streaming it again).
+#[tauri::command]
+pub fn download_cached_path(
+    state: State<'_, AppState>,
+    video_id: String,
+) -> Result<Option<String>, CommandError> {
+    let db = state
+        .db
+        .lock()
+        .map_err(|_| CommandError::DatabaseLock("videos".into()))?;
+    let path: Option<String> = db
+        .connection()
+        .query_row(
+            "SELECT file_path FROM videos WHERE youtube_id = ?1 AND file_path IS NOT NULL
+             ORDER BY id DESC LIMIT 1",
+            [&video_id],
+            |row| row.get(0),
+        )
+        .ok();
+    Ok(path.filter(|p| std::path::Path::new(p).exists()))
+}
+
+/// Toggle the conservative download profile (single connection, chunked ranges,
+/// request pacing, exponential 403 retries).
+fn record_failure(state: &AppState, video_id: &str, title: &str, error: &str, download_id: &str) {
+    let Ok(db) = state.db.lock() else { return };
+    let conn = db.connection();
+    let _ = conn.execute(
+        "INSERT INTO download_queue (youtube_id, youtube_title, status, progress_percent,
+             error_message, download_id)
+         VALUES (?1, ?2, 'failed', 0, ?3, ?4)
+         ON CONFLICT(youtube_id) DO UPDATE SET status='failed', error_message=?3,
+             download_id=?4, completed_at=CURRENT_TIMESTAMP",
+        rusqlite::params![video_id, title, error, download_id],
+    );
+}
+
+#[tauri::command]
+pub fn download_set_robust(state: State<'_, AppState>, enabled: bool) -> Result<(), CommandError> {
+    let db = state
+        .db
+        .lock()
+        .map_err(|_| CommandError::DatabaseLock("download_robust".into()))?;
+    db.set_setting("download_robust", if enabled { "true" } else { "false" })?;
+    info!("download robust mode: {}", enabled);
+    Ok(())
+}
+
+#[tauri::command]
+pub fn download_cancel(download_id: String) -> Result<bool, CommandError> {
+    debug!("download_cancel: '{}'", download_id);
+    Ok(downloader::manager().cancel(&download_id))
+}
+
+#[derive(serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct DownloadRow {
+    pub youtube_id: String,
+    pub title: String,
+    pub status: String,
+    pub progress_percent: i64,
+    pub error_message: Option<String>,
+    pub file_path: Option<String>,
+    pub completed_at: Option<String>,
+}
+
+#[tauri::command]
+pub fn download_list(state: State<'_, AppState>) -> Result<Vec<DownloadRow>, CommandError> {
+    let db: std::sync::MutexGuard<'_, Database> = state
+        .db
+        .lock()
+        .map_err(|_| CommandError::DatabaseLock("download_queue".into()))?;
+    let conn = db.connection();
+    let mut stmt = conn.prepare(
+        "SELECT COALESCE(youtube_id, ''), COALESCE(youtube_title, ''), COALESCE(status, 'pending'),
+                COALESCE(progress_percent, 0), error_message, file_path, completed_at
+         FROM download_queue ORDER BY id DESC LIMIT 100",
+    )?;
+    let rows = stmt
+        .query_map([], |row| {
+            Ok(DownloadRow {
+                youtube_id: row.get(0)?,
+                title: row.get(1)?,
+                status: row.get(2)?,
+                progress_percent: row.get(3)?,
+                error_message: row.get(4)?,
+                file_path: row.get(5)?,
+                completed_at: row.get(6)?,
+            })
+        })?
+        .filter_map(|r| r.ok())
+        .collect();
+    Ok(rows)
+}
