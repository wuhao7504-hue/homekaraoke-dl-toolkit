+++ b/src/stores/prefetchStore.ts
@@ -0,0 +1,98 @@
+import { create } from "zustand";
+import { invoke } from "@tauri-apps/api/core";
+import { createLogger, downloadService } from "../services";
+
+const log = createLogger("Prefetch");
+
+const FLAG_KEY = "karaoke:prefetch-next-song";
+/** How many upcoming songs to keep cached ahead of the player. */
+export const PREFETCH_AHEAD = 3;
+
+const cache = new Map<string, string | null>();
+const inFlight = new Set<string>();
+
+export interface PrefetchTarget {
+  youtubeId?: string;
+  id: string;
+  title: string;
+  artist?: string;
+}
+
+interface PrefetchState {
+  enabled: boolean;
+  setEnabled: (enabled: boolean) => void;
+  /** Local file for this youtube id, if a previous download left one on disk. */
+  cachedPath: (videoId: string) => Promise<string | null>;
+  /** Drop a cached lookup (file gone / play failed). */
+  forget: (videoId: string) => void;
+  /** Record a freshly downloaded file so the next play goes straight to disk. */
+  prime: (videoId: string, filePath: string) => void;
+  /** A download for this id settled — allow a new one. */
+  release: (videoId: string) => void;
+  /** Quietly cache the next few queue entries while the current one plays. */
+  prefetchUpcoming: (videos: PrefetchTarget[], limit?: number) => Promise<void>;
+}
+
+export const usePrefetchStore = create<PrefetchState>((set, get) => ({
+  enabled: localStorage.getItem(FLAG_KEY) !== "false",
+
+  setEnabled: (enabled) => {
+    localStorage.setItem(FLAG_KEY, String(enabled));
+    set({ enabled });
+    log.info(`prefetch next songs: ${enabled}`);
+  },
+
+  cachedPath: async (videoId) => {
+    if (cache.has(videoId)) return cache.get(videoId) ?? null;
+    try {
+      const path = await invoke<string | null>("download_cached_path", { videoId });
+      cache.set(videoId, path);
+      return path;
+    } catch (err) {
+      log.warn(`cachedPath failed: ${err instanceof Error ? err.message : err}`);
+      return null;
+    }
+  },
+
+  forget: (videoId) => {
+    cache.delete(videoId);
+    inFlight.delete(videoId);
+  },
+
+  prime: (videoId, filePath) => {
+    cache.set(videoId, filePath);
+    inFlight.delete(videoId);
+  },
+
+  release: (videoId) => inFlight.delete(videoId),
+
+  prefetchUpcoming: async (videos, limit = PREFETCH_AHEAD) => {
+    if (!get().enabled) return;
+    const targets = videos.slice(0, limit);
+    for (const video of targets) {
+      const videoId = video.youtubeId ?? video.id;
+      if (!videoId || inFlight.has(videoId)) continue;
+      if (await get().cachedPath(videoId)) continue;
+      inFlight.add(videoId);
+      try {
+        await downloadService.start({
+          videoId,
+          title: video.title,
+          artist: video.artist,
+          quality: "720p",
+          silent: true,
+          priority: "background",
+        });
+        log.info(`prefetching: ${video.title}`);
+      } catch (err) {
+        log.warn(`prefetch failed: ${err instanceof Error ? err.message : err}`);
+        inFlight.delete(videoId);
+      }
+    }
+    // 兜底：极端情况下没收到完成事件也不会永久锁死这个 id
+    setTimeout(
+      () => targets.forEach((v) => inFlight.delete(v.youtubeId ?? v.id)),
+      600_000
+    );
+  },
+}));
