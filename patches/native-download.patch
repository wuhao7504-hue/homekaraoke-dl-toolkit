new file mode 100644
index 0000000..7d251b1
--- /dev/null
+++ b/src/components/download/DownloadPanel.tsx
@@ -0,0 +1,196 @@
+import { useEffect } from "react";
+import { Download, X, CheckCircle2, AlertTriangle } from "lucide-react";
+import { useDownloadStore, type DownloadItem } from "../../stores/downloadStore";
+import { HoverScrollText } from "../common";
+import { usePrefetchStore } from "../../stores/prefetchStore";
+
+function statusLabel(item: DownloadItem): string {
+  switch (item.status) {
+    case "queued":
+      return "排队中";
+    case "downloading":
+      return item.speed ? `${item.speed}${item.eta ? ` · 剩余 ${item.eta}` : ""}` : "下载中";
+    case "completed":
+      return item.needsRestart ? "完成（重启后生效）" : "完成";
+    case "failed":
+      return "失败";
+    case "cancelled":
+      return "已取消";
+    default:
+      return item.status;
+  }
+}
+
+/**
+ * Floating download progress panel.
+ *
+ * Mounted once at app level; it also wires the store to the backend
+ * `download:progress` event stream.
+ */
+export function DownloadPanel() {
+  const items = useDownloadStore((state) => state.items);
+  const init = useDownloadStore((state) => state.init);
+  const cancel = useDownloadStore((state) => state.cancel);
+  const remove = useDownloadStore((state) => state.remove);
+  const clearFinished = useDownloadStore((state) => state.clearFinished);
+  const info = useDownloadStore((state) => state.info);
+  const prefetchEnabled = usePrefetchStore((state) => state.enabled);
+  const setPrefetchEnabled = usePrefetchStore((state) => state.setEnabled);
+  const setRobust = useDownloadStore((state) => state.setRobust);
+  const refreshInfo = useDownloadStore((state) => state.refreshInfo);
+  const setCookies = useDownloadStore((state) => state.setCookies);
+
+  useEffect(() => {
+    void init();
+  }, [init]);
+
+  // 冷却倒计时与 POT 探测需要周期性刷新（面板打开时每 15s）
+  useEffect(() => {
+    const timer = setInterval(() => void refreshInfo(), 15000);
+    return () => clearInterval(timer);
+  }, [refreshInfo]);
+
+  const list = Object.values(items);
+  if (list.length === 0) return null;
+
+  const active = list.filter(
+    (item) => item.status === "downloading" || item.status === "queued"
+  ).length;
+
+  return (
+    <div className="fixed bottom-4 right-4 z-50 w-80 rounded-lg border border-gray-700 bg-gray-800/95 shadow-xl backdrop-blur">
+      <div className="flex items-center gap-2 border-b border-gray-700 px-3 py-2">
+        <Download size={14} className="text-blue-400" />
+        <span className="text-sm font-medium text-white">下载队列</span>
+        <span className="text-xs text-gray-400">{active} 首进行中</span>
+        <button
+          onClick={clearFinished}
+          className="ml-auto text-xs text-gray-400 hover:text-gray-200"
+          title="清除已完成"
+        >
+          清除完成
+        </button>
+      </div>
+
+      {info && (
+        <div className="border-b border-gray-700/60 px-3 py-1">
+          <p className="truncate text-[11px] text-gray-400" title={`保存到 ${info.dir}（${info.quality}）`}>
+            保存到 {info.dir}
+          </p>
+          {info.cooldownSeconds > 0 && (
+            <p className="mt-1 text-[11px] text-amber-400">
+              403 过多，冷却中 还需 {Math.floor(info.cooldownSeconds / 60)}:
+              {String(info.cooldownSeconds % 60).padStart(2, "0")}
+            </p>
+          )}
+          <div className="mt-1 flex items-center gap-1">
+            <span className="text-[11px] text-gray-500" title="YouTube 机器人验证时需要用登录了 YouTube 的浏览器 Cookie">
+              Cookie
+            </span>
+            <select
+              value={info.cookies.startsWith("file:") ? "file" : info.cookies}
+              onChange={(e) => void setCookies(e.target.value)}
+              className="rounded border border-gray-600 bg-gray-900 px-1 py-0.5 text-[11px] text-gray-200"
+            >
+              <option value="none">不使用</option>
+              <option value="chrome">Chrome</option>
+              <option value="safari">Safari</option>
+              <option value="edge">Edge</option>
+              <option value="firefox">Firefox</option>
+            </select>
+            <label
+              className="flex items-center gap-1 text-[11px] text-gray-500"
+              title="单连接 + 分段请求 + 请求节流 + 403 指数退避；批量下载更稳"
+            >
+              <input
+                type="checkbox"
+                checked={info.robust}
+                onChange={(e) => void setRobust(e.target.checked)}
+                className="h-3 w-3 accent-emerald-500"
+              />
+              稳健
+            </label>
+            <span
+              className={`text-[11px] ${info.pot ? "text-emerald-400" : "text-gray-600"}`}
+              title={info.pot ? "已检测到 bgutil PO token provider（127.0.0.1:4416）" : "未检测到 PO token provider（可选）"}
+            >
+              POT {info.pot ? "开" : "无"}
+            </span>
+            <label
+              className="ml-auto flex items-center gap-1 text-[11px] text-gray-500"
+              title="播放时把队列里下一首悄悄下载到曲库，轮到它时直接从磁盘播放"
+            >
+              <input
+                type="checkbox"
+                checked={prefetchEnabled}
+                onChange={(e) => setPrefetchEnabled(e.target.checked)}
+                className="h-3 w-3 accent-indigo-500"
+              />
+              缓存下一首
+            </label>
+            {info.cookies.startsWith("file:") && (
+              <span className="truncate text-[11px] text-gray-500" title={info.cookies.slice(5)}>
+                {info.cookies.slice(5)}
+              </span>
+            )}
+          </div>
+        </div>
+      )}
+
+      <div className="max-h-64 overflow-y-auto">
+        {list.map((item) => {
+          const done = item.status === "completed";
+          const failed = item.status === "failed";
+          return (
+            <div key={item.downloadId} className="px-3 py-2 border-b border-gray-700/60 last:border-0">
+              <div className="flex items-start gap-2">
+                {done ? (
+                  <CheckCircle2 size={14} className="mt-0.5 shrink-0 text-green-400" />
+                ) : failed ? (
+                  <AlertTriangle size={14} className="mt-0.5 shrink-0 text-red-400" />
+                ) : (
+                  <Download size={14} className="mt-0.5 shrink-0 text-blue-400" />
+                )}
+                <div className="min-w-0 flex-1">
+                  <HoverScrollText
+                    text={item.title}
+                    className="text-xs text-white"
+                  />
+                  <p className={`text-[11px] ${failed ? "text-red-400" : "text-gray-400"}`}>
+                    {failed && item.error ? item.error : statusLabel(item)}
+                  </p>
+                </div>
+                <span className="shrink-0 text-xs text-gray-400">
+                  {done ? "100%" : `${Math.round(item.percent)}%`}
+                </span>
+                <button
+                  onClick={() =>
+                    item.status === "downloading" || item.status === "queued"
+                      ? void cancel(item.downloadId)
+                      : remove(item.downloadId)
+                  }
+                  className="shrink-0 text-gray-500 hover:text-gray-200"
+                  title={
+                    item.status === "downloading" || item.status === "queued"
+                      ? "取消下载"
+                      : "从列表移除"
+                  }
+                >
+                  <X size={13} />
+                </button>
+              </div>
+              {!done && !failed && (
+                <div className="mt-1 h-1 w-full overflow-hidden rounded bg-gray-700">
+                  <div
+                    className="h-full bg-blue-500 transition-all"
+                    style={{ width: `${Math.max(2, item.percent)}%` }}
+                  />
+                </div>
+              )}
+            </div>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
