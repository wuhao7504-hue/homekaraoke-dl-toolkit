@@ -0,0 +1,74 @@
+import { invoke } from "@tauri-apps/api/core";
+import { listen, type UnlistenFn } from "@tauri-apps/api/event";
+import { createLogger } from "./logger";
+
+const log = createLogger("Downloads");
+
+export type DownloadStatus =
+  | "queued"
+  | "downloading"
+  | "completed"
+  | "failed"
+  | "cancelled";
+
+export interface DownloadProgress {
+  downloadId: string;
+  videoId: string;
+  title: string;
+  status: DownloadStatus;
+  percent: number;
+  speed: string;
+  eta: string;
+  error?: string;
+  filePath?: string;
+  needsRestart?: boolean;
+}
+
+export interface DownloadRow {
+  youtubeId: string;
+  title: string;
+  status: string;
+  progressPercent: number;
+  errorMessage?: string | null;
+  filePath?: string | null;
+  completedAt?: string | null;
+}
+
+export type DownloadQuality = "1080p" | "720p" | "audio";
+
+export const DOWNLOAD_PROGRESS_EVENT = "download:progress";
+
+export const downloadService = {
+  /**
+   * Start a download. Resolves with the download id as soon as yt-dlp is
+   * spawned; progress arrives through `onProgress`.
+   */
+  async start(params: {
+    videoId: string;
+    title: string;
+    artist?: string;
+    quality?: DownloadQuality;
+  }): Promise<string> {
+    log.info(`starting download: ${params.videoId} ${params.title}`);
+    return invoke<string>("youtube_download", {
+      videoId: params.videoId,
+      title: params.title,
+      artist: params.artist ?? null,
+      quality: params.quality ?? null,
+    });
+  },
+
+  async cancel(downloadId: string): Promise<boolean> {
+    return invoke<boolean>("download_cancel", { downloadId });
+  },
+
+  async list(): Promise<DownloadRow[]> {
+    return invoke<DownloadRow[]>("download_list");
+  },
+
+  onProgress(callback: (progress: DownloadProgress) => void): Promise<UnlistenFn> {
+    return listen<DownloadProgress>(DOWNLOAD_PROGRESS_EVENT, (event) =>
+      callback(event.payload)
+    );
+  },
+};
