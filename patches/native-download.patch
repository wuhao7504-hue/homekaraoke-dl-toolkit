diff --git a/src/components/common/HoverScrollText.tsx b/src/components/common/HoverScrollText.tsx
new file mode 100644
index 0000000..4b28ac4
--- /dev/null
+++ b/src/components/common/HoverScrollText.tsx
@@ -0,0 +1,51 @@
+import { useRef, useState } from "react";
+
+interface HoverScrollTextProps {
+  /** Full text — slides into view on hover, also used as the tooltip. */
+  text: string;
+  /** Classes for the outer (clipping) element. */
+  className?: string;
+}
+
+/**
+ * Truncated text with ellipsis at rest that slides sideways on hover to reveal
+ * the full name — used wherever song titles get cut off (download queue,
+ * library list, local search results).
+ */
+export function HoverScrollText({ text, className = "" }: HoverScrollTextProps) {
+  const innerRef = useRef<HTMLSpanElement>(null);
+  const [shift, setShift] = useState(0);
+
+  const handleEnter = () => {
+    const el = innerRef.current;
+    if (!el) return;
+    // measured while the span is still width:100% + overflow:hidden
+    const overflow = el.scrollWidth - el.clientWidth;
+    setShift(overflow > 4 ? overflow : 0);
+  };
+
+  const duration = Math.min(14, Math.max(1.6, shift / 45));
+
+  return (
+    <span
+      className={`block overflow-hidden ${className}`}
+      title={text}
+      onMouseEnter={handleEnter}
+      onMouseLeave={() => setShift(0)}
+    >
+      <span
+        ref={innerRef}
+        className="inline-block whitespace-nowrap align-bottom"
+        style={{
+          width: shift ? "max-content" : "100%",
+          overflow: shift ? "visible" : "hidden",
+          textOverflow: shift ? "clip" : "ellipsis",
+          transform: shift ? `translateX(-${shift}px)` : "translateX(0)",
+          transition: shift ? `transform ${duration}s linear` : "transform 0.25s ease-out",
+        }}
+      >
+        {text}
+      </span>
+    </span>
+  );
+}
