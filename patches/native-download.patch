+            .query_map([], |row| row.get::<_, String>(1))
+            .unwrap()
+            .filter_map(|c| c.ok())
+            .collect();
+
+        for expected in ["file_path", "quality", "file_size_bytes", "download_id"] {
+            assert!(
+                columns.contains(&expected.to_string()),
+                "download_queue should have column {expected}, got {columns:?}"
+            );
+        }
     }
 
